# ---------------------------------------------------------------------------
# Copy to .env (local) or paste into Vercel > Project > Settings > Environment
# Variables. Never commit the filled-in version.
# ---------------------------------------------------------------------------

# Postgres connection string (Supabase, Neon, Vercel Postgres, ...).
# Without it the app runs in in-memory mode: content still renders, but every
# booking and contact message is lost when the process restarts.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Seeds a row in the admin_users table. NOTE: this is not what /admin logs in
# with — see VITE_SUPABASE_* below. Kept because the schema and seed use it.
ADMIN_EMAIL=admin@japhazel.com
ADMIN_PASSWORD=

# REQUIRED to log into /admin. The admin panel authenticates through Supabase
# Auth, not through the admin_users table — without these the login form
# rejects every password. Create the admin account in the Supabase dashboard
# under Authentication > Users.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
